# Optional local overrides. Defaults work without a .env file.

# PostgreSQL major version used to build the database and export images.
POSTGRES_VERSION=14

# Local database credentials. The user matches the roles in the snapshot.
DB_NAME=rdr
POSTGRES_USER=ensreg-usr
POSTGRES_PASSWORD=rdr-local-password

# Host port on 127.0.0.1; containers communicate with db:5432 internally.
DB_SERVICE_PORT_TEST=2345
